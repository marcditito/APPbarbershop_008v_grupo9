<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardBackgroundColor="@color/dark_card"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    style="@style/Widget.Material3.CardView.Elevated">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Información del producto -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <!-- Imagen del producto -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginEnd="12dp"
                app:cardBackgroundColor="@color/dark_surface"
                app:cardCornerRadius="8dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@android:drawable/ic_menu_gallery"
                    android:tint="@color/accent_gold"
                    android:padding="12dp"
                    android:scaleType="centerInside"
                    android:contentDescription="Imagen del producto"/>
            </com.google.android.material.card.MaterialCardView>

            <!-- Info del producto -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textCartProductName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nombre del Producto"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end"/>

                <TextView
                    android:id="@+id/textCartProductPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$25.99"
                    android:textColor="@color/accent_green"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>

            <!-- Subtotal -->
            <TextView
                android:id="@+id/textCartSubtotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$51.98"
                android:textColor="@color/accent_green"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_gravity="center"/>

        </LinearLayout>

        <!-- Controles de cantidad -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Botón disminuir -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonDecrease"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="-"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                app:backgroundTint="@color/accent_red"
                app:cornerRadius="20dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginEnd="12dp"
                style="@style/Widget.Material3.Button"/>

            <!-- Cantidad -->
            <TextView
                android:id="@+id/textCartQuantity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:minWidth="40dp"
                android:gravity="center"
                android:layout_marginHorizontal="8dp"/>

            <!-- Botón aumentar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonIncrease"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="+"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                app:backgroundTint="@color/accent_green"
                app:cornerRadius="20dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginStart="12dp"
                style="@style/Widget.Material3.Button"/>

            <!-- Spacer -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <!-- Botón eliminar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonRemoveItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Eliminar"
                android:textColor="@color/white"
                android:textSize="12sp"
                app:backgroundTint="@color/accent_red"
                app:cornerRadius="6dp"
                app:icon="@android:drawable/ic_menu_delete"
                app:iconTint="@color/white"
                app:iconSize="16dp"
                style="@style/Widget.Material3.Button.OutlinedButton"/>

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
